PORT=5000
SUPABASE_URL=your_supabase_project_url_here
# Required: service_role / secret key (Supabase -> Project Settings -> API Keys). The anon key cannot read the tables.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Used by the migration scripts. If db.<project>.supabase.co does not resolve, use the Session pooler string.
DATABASE_URL=postgresql://postgres:your_password@your_supabase_host:5432/postgres
# Signs login tokens. Any long random string; if empty the service role key is used.
JWT_SECRET=change_me_to_a_long_random_string
